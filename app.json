{
  "expo": {
    "name": "FuelPay Sales",
    "slug": "FuelPay Sales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "backgroundColor": "#FFFFFF", 
      "resizeMode": "contain"
    },
    "scheme": "petrolbunkfinder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "config": {
        "googleMapsApiKey": "AIzaSyCcUHK4ZfZ2o98ag8S7t2EbfCNs1MLVizM"
      },
      "bundleIdentifier": "com.kalaiselvanpalanisamy.petrolbunkfinder",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCcUHK4ZfZ2o98ag8S7t2EbfCNs1MLVizM"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.kalaiselvan_palanisamy.petrolbunkfinder"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Petrol Bunk Finder to use your location to find bunks along your route.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to take visit photos.",
          "photosPermission": "Allow $(PRODUCT_NAME) to choose visit photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to detect the bunk location."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
       [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4722103e-8cd2-4b52-8384-3991bf4395c4"
      }
    }
  }
}
